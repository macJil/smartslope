+    $stmt = $pdo->prepare("UPDATE readings r JOIN events e ON e.id = r.event_id
+        SET r.archived = 1 WHERE e.id = ? AND e.type = 'reading' AND r.archived = 0");
+    $stmt->execute([$id]);
+    return $stmt->rowCount() === 1;
+}

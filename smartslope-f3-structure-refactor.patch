+        $stmt=$pdo->prepare("SELECT r.risk_level, r.adjustment_log FROM readings r
+            JOIN events e ON e.id=r.event_id
+            WHERE e.id=? AND e.type='reading' AND r.archived=0 FOR UPDATE");

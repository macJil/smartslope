# Apache/XAMPP: prevent direct downloads or execution of internal application files.
Options -Indexes
<FilesMatch "(?i)^(\.env(?:\..*)?|.*\.(?:sql|patch|log|md))$">
    Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:app|data|database|scripts|tests|docs)(?:/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

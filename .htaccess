# Apache 2.4 (XAMPP/MAMP). No URL rewriting or Options override is needed.
# Keep source/configuration downloads private.
<FilesMatch "(?i)^(\..*|config\.php|functions\.php|.*\.(?:sql|patch|log|md))$">
    Require all denied
</FilesMatch>
# Block internal directories at both localhost/ and localhost/smartslope/.
<If "%{REQUEST_URI} =~ m#/(?:includes|partials|data|database|scripts|tests|docs|\.[^/]+)(?:/|$)#">
    Require all denied
</If>

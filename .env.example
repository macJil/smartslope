# SmartSlope Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartslope_mvp
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME=SmartSlope
READING_MAX_AGE_SECONDS=10800
NOMINATIM_ENABLED=true

# Optional: CSV Signing Key (generated automatically if needed)
# CSV_SIGNING_KEY=

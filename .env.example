DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartslope_mvp
DB_USERNAME=root
DB_PASSWORD=
# Leave blank to detect /smartslope automatically on XAMPP or / on Herd.
APP_BASE_PATH=

# Application freshness policy in seconds (not a landslide threshold).
READING_MAX_AGE_SECONDS=10800

# Reverse address lookup for points selected by a signed-in user.
# Requires internet; set to 0 for an offline-only installation.
NOMINATIM_ENABLED=1

# Optional 64-hex-character secret for location CSV verification.
# If blank, the first location export creates and saves one in .env. Back it up.
CSV_SIGNING_KEY=

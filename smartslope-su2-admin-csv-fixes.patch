+const AWARENESS_COLUMNS = ['rule_version'=>'VARCHAR(40) NULL','rainfall_window_end'=>'DATETIME NULL',
+    'provider_payload'=>'LONGTEXT NULL','adjustment_log'=>'LONGTEXT NULL','report_type'=>'VARCHAR(30) NULL',
